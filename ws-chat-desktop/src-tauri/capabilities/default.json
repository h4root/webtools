{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окно ввода адреса. Странице сервера ничего из этого не достаётся.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*/*" }, { "url": "https://*:*/*" }, { "url": "http://*/*" }, { "url": "https://*/*" }]
    }
  ]
}

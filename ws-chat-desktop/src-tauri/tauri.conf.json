{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ws-chat",
  "version": "0.1.0",
  "identifier": "dev.h4root.ws-chat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ws-chat",
        "width": 1100,
        "height": 720,
        "minWidth": 420,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/128x128.png"]
  }
}

PORT=3000
HOST=0.0.0.0

# Каталог с историей (store.json), вложениями и ключом шифрования.
# DATA_DIR=./data

# Ключ шифрования вложений, 32 байта в hex (openssl rand -hex 32).
# Если не задан - генерируется в DATA_DIR/upload.key при первом запуске.
# Задавай явно, если каталог данных не переживает деплой: без старого ключа
# ранее загруженные вложения не открыть.
# UPLOAD_KEY=

# HTTPS (нужен для микрофона/камеры с других устройств в LAN).
# Укажи пути к сертификату и ключу - тогда сервер поднимется по https/wss.
# TLS_KEY=./key.pem
# TLS_CERT=./cert.pem

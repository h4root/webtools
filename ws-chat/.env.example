PORT=3000
HOST=0.0.0.0

# Каталог с историей (store.json), вложениями и ключом шифрования.
# DATA_DIR=./data

# Ключ шифрования вложений, 32 байта в hex (openssl rand -hex 32).
# Если не задан - генерируется в DATA_DIR/upload.key при первом запуске.
# Задавай явно, если каталог данных не переживает деплой: без старого ключа
# ранее загруженные вложения не открыть.
# UPLOAD_KEY=

# HTTPS (нужен для микрофона/камеры/звонков с других устройств в LAN).
# Сертификат: npm run cert - он положит файлы сюда и напечатает эти строки.
# TLS_KEY=./data/tls/key.pem
# TLS_CERT=./data/tls/cert.pem

# Доверять X-Forwarded-For при определении адреса клиента.
# Включать ТОЛЬКО если сервер стоит за своим обратным прокси: иначе заголовок
# подставит кто угодно и обойдёт лимит на попытки входа.
# TRUST_PROXY=1

# Пределы соединений и срок на представление. Значения по умолчанию рассчитаны
# на локальную сеть; менять есть смысл при выставлении наружу.
# CONNS_PER_SOURCE=24
# CONNS_TOTAL=256
# AUTH_GRACE_MS=30000
